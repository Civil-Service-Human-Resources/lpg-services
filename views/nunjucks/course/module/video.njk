{% extends baseLayout %}

{% set pageTitle = moduleTitle %}

{% block content %}
    <div class="container">
        <p class="no-margin">
            <a class="link-back" href="/courses/{{ courseId }}">Return to course</a>
        </p>
        <h1 class="heading-xlarge heading heading--page-heading ">
            {{ moduleTitle }}
        </h1>
        <div class="grid-row">
            <div class="column-two-thirds">
                <div class="aspect__container">
                    <div class="video aspect__content">
                        {% block videoContent %}
                            <video id="videojs-player" class="video-js" controls preload="auto" width="640" height="400" data-setup="">
                                <source src="{{ launchLink }}" type='video/mp4'>
                                <p class="vjs-no-js">
                                    To view this video please enable JavaScript and consider upgrading to a web browser that supports HTML5 video.
                                </p>
                            </video>
                            <script src="{{ asset('/js/video.min.js') }}"></script>
                        {% endblock %}
                        <script src="{{ asset('js/video.js') }}"></script>
                        <input type="hidden" id="course-id" value="{{ courseId }}">
                        <input type="hidden" id="module-id" value="{{ moduleId }}">
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}