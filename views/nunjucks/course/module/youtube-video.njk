{% extends "./video.njk" %}

{% block videoContent %}
    {% if video %}
        <div id="video-player"></div>
        <noscript>
            <iframe title="{{ moduleTitle }}" src="https://www.youtube.com/embed/{{ video.id }}" frameborder="0" scrolling="no"></iframe>
        </noscript>
        <input type="hidden" id="video-id" value="{{ video.id }}">
    {% else %}
        <p class='govuk-body'>This Youtube video could not be found. Please <a class='govuk-link' href='/contact-us'>contact us</a>.</p>
    {% endif %}
{% endblock %}