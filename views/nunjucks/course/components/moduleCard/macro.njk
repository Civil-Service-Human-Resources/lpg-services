{% macro moduleCardTitle(params) %}
    <div class="discite__main discite__main--module">
        <h3 class="heading bold-small heading--text">{{ params.title }}</h3>
        {% if params.description %}
            <p class="discite__description">{{ params.description }}</p>
        {% endif %}
        {% if params.displayMandatoryStatus %}
            {% if params.isMandatory %}
                <p class="discite__description bold-small">This module is mandatory</p>
            {% else %}
                <p class="discite__optional bold-small">This module is optional</p>
            {% endif %}
        {% endif %}
    </div>
{% endmacro %}

{% macro moduleCardDetails(params) %}
    <div class="discite__properties u-clearfix">
        <ul class="discite__property">
            <li class="discite__property-item">
                <span>Type:</span>
                <span class="lpg-course-type">{{ i18n(params.type) }}</span>
            </li>
            {% if params.duration %}
                <li class="discite__property-item">
                    <span>Duration:</span>
                    <span class="lpg-course-duration">{{ params.duration }}</span>
                </li>
            {% endif %}
            {% if params.type !== 'file' %}
                <li class="discite__property-item">
                    <span>Cost:</span>
                    <span class="lpg-course-cost">&pound;{{ params.cost or 'Free' }}</span>
                </li>
            {% endif %}
        </ul>
        {% if params.displayState %}
            <div class="discite__status"><span class="badge badge--info ">{{ i18n(params.displayState) }}</span></div>
        {% endif %}
    </div>
{% endmacro %}

{% macro moduleCardCtaLink(params) %}
    <form class="discite__link-button--main" method="POST" action="{{ params.url }}" rel='noopener' novalidate>
        <input type="hidden" name="_csrf" value="{{ _csrf }}" />
        {{ params.ctaButton | safe }}
        <button type="submit" class="discite__link-button--main discite__action-link--button"
                data-module="discite-prevent-double-click" data-timeout="{{ doubleClickPreventionTimeout }}"
                {% if params.newTab %}formtarget="_blank"{% endif %}>
            {{ params.buttonHtml | safe }}
        </button>
    </form>
    {{ params.extraText }}
{% endmacro %}

{% macro moduleCardCta(params) %}
    {% if params.mustConfirmBooking %}
        <p style="display: inline-block">Available on confirmation of a booking</p>
    {% else %}
        <div class="discite__action discite__action--module">
            {% if not signedInUser.lineManager and params.type === "face-to-face" %}
                <span>You must <a class="discite__action-link" href='/profile/line-manager?redirectTo={{ originalUrl }}'>add a line manager</a> to book this module</span>
            {% elseif not params.canBeBooked and params.type === "face-to-face" %}
                <span>{{ i18n('components.notification_banner.course_not_bookable') }}</span>
            {% else %}
                {% set typeMap = {
                    "face-to-face": {buttonHtml: 'Book <span class="visually-hidden">' + params.title + '</span>'},
                    "file": {buttonHtml: 'Download <span class="visually-hidden">' + params.title + '</span> file', extraText: params.fileExtAndSize},
                    "video": {buttonHtml: 'Go to <span class="visually-hidden">'+  params.title + '</span> video'},
                    "link": {buttonHtml: 'Go to ' + params.title + ' (opens in a new tab)', newTab: true},
                    "elearning": {buttonHtml: 'Start <span class="visually-hidden">' + params.title + '</span>'}
                } %}
                {{ moduleCardCtaLink({
                    url: params.launchLink,
                    buttonHtml: typeMap[params.type].buttonHtml,
                    newTab: typeMap[params.type].newTab,
                    extraText: typeMap[params.type].extraText
                }) }}
            {% endif %}
        </div>
    {% endif %}
{% endmacro %}

{% macro moduleCard(module) %}
    <div class="discite__item u-clearfix discite__item--module">
        {{ moduleCardTitle(module) }}
        {{ moduleCardDetails(module) }}
        {{ moduleCardCta(module) }}
    </div>
{% endmacro %}
