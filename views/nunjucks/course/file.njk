{% extends "./singleModuleLayout.njk" %}

{% block courseContent %}
    <h3 class="heading-small">Download document</h3>
    <a href="/courses/{{ pageModel.id }}/{{ moduleDetails.id }}">{{ moduleDetails.filename }}</a>
    ({{ moduleDetails.extension }}, {{ moduleDetails.sizeInKb | appropriateFileSize }})
{% endblock %}
