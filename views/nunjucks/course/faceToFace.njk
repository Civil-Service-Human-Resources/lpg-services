{% block headingBanner %}
    {% if signedInUser.hasLineManager() and not moduleDetails.canBeCancelled and not moduleDetails.canBeBooked %}
        <div class="grid-row">
            <div class="column-two-thirds">
                {{ notificationBanner({
                    description: i18n('components.notification_banner.course_not_bookable')
                }) }}
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block courseContent %}
    {% if moduleDetails.canBeCancelled %}
        <p>You are already booked on this course. <a href="/book/{{ pageModel.id }}/{{ moduleDetails.id }}/{{ moduleDetails.bookedEventId }}/cancel">Do you wish to cancel your booking?</a></p>
    {% else %}
        {% if not signedInUser.hasLineManager() %}
            <p class='govuk-body'>
                <span>You must <a class="discite__action-link" href='/profile/line-manager?redirectTo={{ originalUrl }}'>add a line manager</a> to book this course</span>
            </p>
        {% elseif moduleDetails.canBeBooked %}
            <div class="notice push-bottom">
                <i class="icon icon-important">
                    <span class="visually-hidden">Warning</span>
                </i>
                <strong class="bold-small">
                    By proceeding, you are confirming you have gained approval to book this course and have a purchase
                    order number.
                </strong>
            </div>
            {% include partials + "/howToGetPO.html" %}
            <a class="button" href="/courses/{{ pageModel.id }}/{{ moduleDetails.id }}/choose-date">View availability</a>
        {% endif %}
    {% endif %}
{% endblock %}
