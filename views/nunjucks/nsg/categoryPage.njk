{% from "./components/categoryCard/macro.njk" import categoryCard %}
{% from "./components/categoryCourseDisplay/macro.njk" import categoryCourseDisplay %}
{% from "./components/categoryLinkDisplay/macro.njk" import categoryLinkDisplay %}
{% from "./components/categoryTabbedDisplay/macro.njk" import categoryContentTabs %}
{% from "breadcrumbs/macro.njk" import govukBreadcrumbs %}
{% from "pagination/macro.njk" import govukPagination %}

{% extends "./baseLayout.njk" %}

{% set pageTitle = page.title %}

{% set navbarTab = "home" %}

{% block content %}
    {% set isTier1 = not page.parents or page.parents.length === 0 %}
    {% set isCoursesOrLinks = contentType === 'courses' or contentType === 'links' %}
    {% set breadcrumbs = [] %}
    {% set breadcrumbs = (breadcrumbs.push({"href": NSG_ROUTER_BASE, "text": "Home"}), breadcrumbs) %}
    {% if page.parents %}
        {% for parent in page.parents %}
            {% set breadcrumbs = (breadcrumbs.push(parent), breadcrumbs) %}
        {% endfor %}
    {% endif %}
    {% if isCoursesOrLinks %}
        {% set breadcrumbs = (breadcrumbs.push({"href": NSG_ROUTER_BASE + "/topics/" + url, "text": page.title}), breadcrumbs) %}
        {% set breadcrumbs = (breadcrumbs.push({"text": "Courses and Links assigned to " + page.title}), breadcrumbs) %}
    {% else %}
        {% set breadcrumbs = (breadcrumbs.push({"text": page.title}), breadcrumbs) %}
    {% endif %}
    {{ govukBreadcrumbs({
        items: breadcrumbs,
        collapseOnMobile: true
    }) }}
    <h1 class='govuk-heading-l'>
        {{ page.title }}
    </h1>
    <p class='govuk-body category__description'>
        {{ page.description }}
    </p>
    {% if not isCoursesOrLinks %}
        {% if page.hasContent() if page.hasContent else (page.courseCount > 0 or page.linkCount > 0) %}
            <div class='category__action-link'>
                <a class='category-card__action-link category-card__action-link--main' href='{{ NSG_ROUTER_BASE }}/topics/{{ url }}/{{ 'courses' if page.courseCount > 0 else 'links' }}'>View {{ page.title }} courses and links</a>
            </div>
        {% endif %}
        {% if page.categories and page.categories.length > 0 %}
            <div class='category-card__container'>
                {% for category in page.categories %}
                    {{ categoryCard({
                        title: category.title,
                        description: category.description,
                        fullUrl: category.url,
                        categories: category.categories,
                        courseCount: category.courseCount,
                        linkCount: category.linkCount,
                        hasDirectContent: category.getHasDirectContent() if category.getHasDirectContent else category.hasDirectContent
                    }) }}
                {% endfor %}
            </div>
        {% endif %}
    {% elif page.rows.length > 0 %}
        {% if page.courseCount > 0 and page.linkCount > 0 %}
            {{ categoryContentTabs({
                rows: page.rows,
                display: page.getDisplay(),
                courseCount: page.courseCount,
                linkCount: page.linkCount,
                baseUrl: NSG_ROUTER_BASE + "/topics/" + url
            }) }}
        {% elif page.getDisplay() === 'courses' %}
            {{ categoryCourseDisplay({
                rows: page.rows
            }) }}
        {% elif page.getDisplay() === 'links' %}
            {{ categoryLinkDisplay({
                rows: page.rows
            }) }}
        {% endif %}
        <div class='category__pagination'>
            <p class='govuk-body'>Showing {{ pagination.start }} – {{ pagination.end }} of {{ pagination.total }} items</p>
            {{ govukPagination({
                previous: {
                    href: pagination.prevLink
                },
                next: {
                    href: pagination.nextLink
                },
                items: pagination.numberedPages
            }) }}
        </div>
    {% endif %}

{% endblock %}